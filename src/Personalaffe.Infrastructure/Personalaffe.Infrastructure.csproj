<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../Personalaffe.Application/Personalaffe.Application.csproj" />
  </ItemGroup>

  <!-- Postgres lives here, and brings its packages with the code that uses
       them. -->
  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- The owner's password hash, and nothing else uses it. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <!-- Design-time only: this project is its own startup project for
         `dotnet ef`, through the factory in Persistence. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
