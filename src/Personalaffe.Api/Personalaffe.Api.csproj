<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>personalaffe-api</UserSecretsId>
    <!-- The operational verbs the CLI deliberately does not have — migrations,
         backups — run as `docker compose exec personalaffe personalaffe …`, so
         the binary is named for the line it appears in (docs/codebase.md). -->
    <AssemblyName>personalaffe</AssemblyName>
    <RootNamespace>Personalaffe.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Personalaffe.Application/Personalaffe.Application.csproj" />
    <ProjectReference Include="../Personalaffe.Infrastructure/Personalaffe.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

</Project>
