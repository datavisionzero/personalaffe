# Copy to deploy/.env and set the one value above the optional block.
# The file is ignored by git.

# The database password, shared by the two services.
POSTGRES_PASSWORD=

# Optional. Defaults shown.

# The host port. The value is the whole left half of the published port, so an
# address in front of it binds there and nowhere else. The default is loopback,
# and while the workspace itself is still being built (PERSONAL-E3 and later)
# that is the only setting this instance should be run with.
# PERSONALAFFE_PORT=127.0.0.1:8080

# The reverse proxy in front of the instance, so that the caller's address and
# scheme are the caller's rather than the proxy's. An address, a CIDR network,
# or `all` where the proxy is the only thing that can reach the instance.
# Unset, no forwarded header is believed.
# PERSONALAFFE_TRUSTED_PROXY=all

# Where this instance is reached from a browser. Optional: what it buys is a
# stricter check on writes made from a browser, which without it are checked
# against the host the request arrived at. It is never used to build a link.
# PERSONALAFFE_PUBLIC_URL=https://workspace.example.com

# Verbose, Debug, Information, Warning, Error or Fatal.
# PERSONALAFFE_LOG_LEVEL=Information

# How long the Trash keeps what was deleted, in whole days, 1 to 3650. Thirty
# by default.
# PERSONALAFFE_TRASH_RETENTION=30

# How long an unpinned Scratchpad entry lasts after it was last changed, in
# whole days, 1 to 3650. Seven by default. A pinned entry never expires; these
# are two periods and not one (docs/operations.md).
# PERSONALAFFE_SCRATCHPAD_RETENTION=7

# How large one stored file may be, in whole mebibytes. 64 by default. Over it
# is refused as `too-large` while the upload is still arriving, so a body that
# claims nothing cannot fill the volume.
# PERSONALAFFE_MAX_FILE_MIB=64

# How much the Files application may store in all, in whole mebibytes. 5120 by
# default. What is in the Trash counts towards it — those bytes are still there
# and still restorable — so emptying the Trash is what gives room back at once.
# PERSONALAFFE_MAX_STORAGE_MIB=5120

# The image this instance runs. There is no published release yet, so the
# Compose file defaults to what a local build produces:
#
#   docker build -f deploy/Dockerfile -t personalaffe:local .
#
# PERSONALAFFE_IMAGE=personalaffe:local
