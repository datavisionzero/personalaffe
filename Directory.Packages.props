<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Only what something already uses. A version pinned before there is a
       reference to it is a decision with no reason attached; the contract and
       the file store each bring their own when they arrive. -->

  <ItemGroup Label="Persistence">
    <!-- The one place that declares schema (docs/codebase.md): EF Core owns the
         tables and the migrations that apply themselves on startup. The
         design-time package is what `dotnet ef migrations add` needs, and it
         stays out of the runtime through PrivateAssets on the reference. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!-- The Npgsql provider asks for an older EF Core patch than the design-time
         package does. Pinned to one version so the two do not meet as a runtime
         binding conflict in the test project, where both arrive. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <!-- Structured logging to the console, and nothing else. personalaffe runs
         on one machine for one person and must not depend on another running
         affe product for its log (docs/codebase.md). -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- Starts the composition root in the test process, which is the only way
         to say that the host refuses to serve rather than that a line of
         Program.cs says so. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />

    <!-- Nothing here calls SSH.NET. It arrives under Testcontainers, whose
         newest release still asks for the version GHSA-q939-rpr3-3284 was filed
         against — and `TreatWarningsAsErrors` turns that audit warning into a
         failed restore. Naming it here lifts the transitive reference to the
         patched one. Drop both lines once Testcontainers asks for the patched
         version itself. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
